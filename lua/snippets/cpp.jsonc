	"Modular int data type": {
		"prefix": "mint",
		"body": [
			"template <int MOD>",
			"struct ModInt {",
				"\tint val;",
				"\tModInt(int v = 0) {",
					"\t\tif (v < 0) v = v % MOD + MOD;",
					"\t\tif (v >= MOD) v %= MOD;",
					"\t\tval = v;",
					"\t}",
					"\texplicit operator int() const { return val; }",
					"\tbool operator==(const ModInt& o) const { return val == o.val; }",
					"\tbool operator!=(const ModInt& o) const { return val != o.val; }",
					"\tModInt& operator+=(const ModInt& o) { val += o.val; if (val >= MOD) val -= MOD; return *this; }",
					"\tModInt& operator-=(const ModInt& o) { val -= o.val; if (val < 0) val += MOD; return *this; }",
					"\tModInt& operator*=(const ModInt& o) { val = (val * o.val) % MOD; return *this; }",
					"\tModInt& operator/=(const ModInt& o) { return *this *= o.inv(); }",
					"\tfriend ModInt operator+(ModInt a, const ModInt& b) { return a += b; }",
					"\tfriend ModInt operator-(ModInt a, const ModInt& b) { return a -= b; }",
					"\tfriend ModInt operator*(ModInt a, const ModInt& b) { return a *= b; }",
					"\tfriend ModInt operator/(ModInt a, const ModInt& b) { return a /= b; }",
					"\tModInt operator-() const { return ModInt(-val); }",
					"\tModInt& operator++() { return *this += 1; }",
					"\tModInt& operator--() { return *this -= 1; }",
					"\tfriend ostream& operator<<(ostream& os, const ModInt& m) { return os << m.val; }",
					"\tfriend istream& operator>>(istream& is, ModInt& m) { int v; is >> v; m = ModInt(v); return is; }",
					"\t",
					"\tModInt inv() const { return power(*this, MOD - 2); }",
					"\tfriend ModInt power(ModInt a, int b) {",
						"\t\tModInt res = 1;",
						"\t\twhile (b) { if (b & 1) res *= a; a *= a; b >>= 1; }",
						"\t\treturn res;",
						"\t}",
						"};",
						"using mint = ModInt<1000000007>;",
						""
		],
		"description": "Modular int data type"
	}
}
