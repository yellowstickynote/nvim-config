			"#endif",
			"#include <ext/pb_ds/assoc_container.hpp>",
			"using namespace __gnu_pbds;",
			"template <class T>",
			"using Tree =tree<T, null_type, less<T>, rb_tree_tag, tree_order_statistics_node_update>;",
			"",
			"#define pb push_back",
			"#define eb emplace_back",
			"#define fi first",
			"#define se second",
			"#define int long long",
			"typedef pair<int, int> pint;",
			"#define vint vector<int>",
			"#define fast_cin()\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t \\",
			"\tios_base::sync_with_stdio(false);\t\t\t\t\t\t\t\t\t\t  \\",
			"\tcin.tie(NULL);\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t \\",
			"\tcout.tie(NULL)",
			"constexpr int mod = 1e9+7;",
			"#define endl \"\\n\"",
			"",
			"void solve() {",
				"\t$0",
				"}",
				"signed main() {",
					"\tfast_cin();",
					"#ifdef MYPC",
					"\tfreopen(\"input.in\", \"r\", stdin);",
					"\t//freopen(\"input.out\",\"w\",stdout);",
